<Project>

  <Import Project="$(MSBuildThisFileDirectory)../Directory.Build.props" />

  <!-- Shipping projects: everything under src/ is packed and published to NuGet. -->

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <PropertyGroup>
    <!-- The SDK must work in trimmed and native-AOT apps: this marks the
         package as such and turns on the trim/AOT/single-file analyzers, so a
         reflection- or dynamic-codegen-dependent change fails the build here
         rather than in a consumer's publish. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>Occtoo</Authors>
    <Company>Occtoo</Company>
    <Product>Occtoo .NET SDK</Product>
    <Copyright>Copyright (c) Occtoo</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Occtoo/dotnet-sdk</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>occtoo;ingest;events;cloudevents;sdk</PackageTags>
    <RepositoryUrl>https://github.com/Occtoo/dotnet-sdk</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Reproducible builds + debuggable packages. -->
    <Deterministic>true</Deterministic>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../README.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
  </ItemGroup>

</Project>
