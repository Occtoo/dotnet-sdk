{
  "Occtoo": {
    "ClientId": "<your-application-client-id>",
    "ClientSecret": "<your-application-client-secret>",
    "TenantId": "<your-tenant-id>",
    "SourceId": "<your-source-id>",
    "Interval": "00:00:30"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",

      // The SDK's own logs. At Information you see the meaningful state
      // changes: tokens acquired (with expiry), batches accepted (with the
      // correlation id support asks for), recoveries from a revoked token.
      // Turn it up to "Debug" to trace decisions — token cache misses, why the
      // token endpoint was called again, device-login polling — or "Trace" to
      // also see per-request token cache hits.
      "Occtoo": "Information",

      // The raw HTTP traffic underneath (method, URL, status, duration) —
      // AddOcctooClient registers a named HttpClient called "Occtoo". Kept at
      // Warning because the SDK's own logs above cover the story; set to
      // "Information" to see every request on the wire.
      "System.Net.Http.HttpClient.Occtoo": "Warning"
    }
  }
}
