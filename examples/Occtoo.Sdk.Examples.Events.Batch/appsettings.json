{
  "Occtoo": {
    "ClientId": "<your-application-client-id>",
    "ClientSecret": "<your-application-client-secret>",
    "TenantId": "<your-tenant-id>",
    "DestinationId": "<your-durable-consumer-destination-id>",
    "Workers": 2,
    "BatchSize": 20,
    "LeaseDuration": "00:01:00",
    "IdleDelay": "00:00:05",
    "MaxAttempts": 5
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",

      // The SDK's own logs. "Occtoo.Events" at Debug shows every batch pulled
      // (with its lease and attempt) and every acknowledgement; stale
      // acknowledgements are warnings at any level.
      "Occtoo": "Information",

      // The raw HTTP traffic underneath (method, URL, status, duration).
      "System.Net.Http.HttpClient.Occtoo": "Warning"
    }
  }
}
